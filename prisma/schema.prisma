datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  passwordHash   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  profile        Profile?
  attributes     Attribute[]
  tasks          Task[]
  taskCompletions TaskCompletion[]
  achievements   UserAchievement[]
  bosses         Boss[]
  inventory      Inventory[]
  xpTransactions XpTransaction[]
  activityLogs   ActivityLog[]
  guildMembers   GuildMember[]
}

model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique
  username        String    @unique
  title           String    @default("Novice Wanderer")
  totalXp         Int       @default(0)
  currentLevel    Int       @default(1)
  gold            Int       @default(0)
  currentAp       Int       @default(100)
  maxAp           Int       @default(100)
  streakCurrent   Int       @default(0)
  streakLongest   Int       @default(0)
  lastActiveDate  DateTime?
  momentumScore   Int       @default(0)
  timezone        String    @default("UTC")
  boostExpiresAt  DateTime?
  activeTheme     String    @default("synthwave")
  avatarId        String    @default("pixel_knight")
  sfxEnabled      Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attribute {
  id            String   @id @default(uuid())
  userId        String
  attributeCode String
  currentXp     Int      @default(0)
  currentLevel  Int      @default(1)
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attributeCode])
}

model Task {
  id             String          @id @default(uuid())
  userId         String
  parentTaskId   String?
  title          String
  description    String?
  notes          String?
  attributeCode  String
  difficulty     String          @default("Medium")
  xpReward       Int
  goldReward     Int
  apCost         Int             @default(10)
  status         String          @default("ACTIVE")
  stage          String          @default("TODO")
  isRecurring    Boolean         @default(false)
  recurrence     String          @default("NONE") // NONE | DAILY | WEEKLY
  recurrenceRule String?
  tags           String?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentTask     Task?           @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks       Task[]          @relation("SubTasks")
  completions    TaskCompletion[]
  bossMilestone  BossMilestone?
}

model TaskCompletion {
  id             String   @id @default(uuid())
  taskId         String
  userId         String
  completionDate DateTime
  awardedXp      Int
  awardedGold    Int
  createdAt      DateTime @default(now())

  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, completionDate])
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  description      String
  assetKey         String
  createdAt        DateTime          @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Boss {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String?
  totalHp     Int
  currentHp   Int
  status      String          @default("ACTIVE")
  rewardXp    Int             @default(500)
  rewardGold  Int             @default(250)
  defeatedAt  DateTime?
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  BossMilestone[]
}

model BossMilestone {
  id          String    @id @default(uuid())
  bossId      String
  taskId      String?   @unique
  title       String
  damageHp    Int
  status      String    @default("PENDING")
  completedAt DateTime?

  boss        Boss      @relation(fields: [bossId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Item {
  id          String      @id
  name        String
  itemType    String
  description String
  priceGold   Int
  assetKey    String
  isActive    Boolean     @default(true)

  inventory   Inventory[]
}

model Inventory {
  id         String   @id @default(uuid())
  userId     String
  itemId     String
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model XpTransaction {
  id          String   @id @default(uuid())
  userId      String
  deltaXp     Int
  deltaGold   Int
  sourceType  String
  sourceId    String?
  description String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String
  date           String   // YYYY-MM-DD
  xpEarned       Int      @default(0)
  tasksCompleted Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Guild {
  id          String        @id @default(uuid())
  name        String
  tag         String        @unique
  description String?
  level       Int           @default(1)
  createdAt   DateTime      @default(now())

  members     GuildMember[]
  bosses      GuildBoss[]
}

model GuildMember {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  role      String   @default("MEMBER") // "LEADER" | "OFFICER" | "MEMBER"
  joinedAt  DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model GuildBoss {
  id         String   @id @default(uuid())
  guildId    String
  title      String
  totalHp    Int      @default(5000)
  currentHp  Int      @default(5000)
  status     String   @default("ACTIVE") // "ACTIVE" | "DEFEATED"
  rewardXp   Int      @default(1500)
  rewardGold Int      @default(750)
  createdAt  DateTime @default(now())

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}
