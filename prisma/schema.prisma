datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  profile        Profile?
  attributes     Attribute[]
  tasks          Task[]
  taskCompletions TaskCompletion[]
  bosses         Boss[]
  inventory      Inventory[]
  xpTransactions XpTransaction[]
}

model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique
  username        String    @unique
  title           String    @default("Novice Wanderer")
  totalXp         Int       @default(0)
  currentLevel    Int       @default(1)
  gold            Int       @default(0)
  streakCurrent   Int       @default(0)
  streakLongest   Int       @default(0)
  lastActiveDate  DateTime?
  momentumScore   Int       @default(50)
  activeTheme     String    @default("synthwave")
  avatarId        String    @default("pixel_knight")
  sfxEnabled      Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attribute {
  id            String   @id @default(uuid())
  userId        String
  attributeCode String
  currentXp     Int      @default(0)
  currentLevel  Int      @default(1)
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attributeCode])
}

model Task {
  id             String          @id @default(uuid())
  userId         String
  title          String
  description    String?
  attributeCode  String
  difficulty     String          @default("Medium")
  xpReward       Int
  goldReward     Int
  status         String          @default("ACTIVE")
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions    TaskCompletion?
  bossMilestone  BossMilestone?
}

model TaskCompletion {
  id             String   @id @default(uuid())
  taskId         String   @unique
  userId         String
  completionDate DateTime
  awardedXp      Int
  awardedGold    Int
  createdAt      DateTime @default(now())

  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Boss {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String?
  totalHp     Int
  currentHp   Int
  status      String          @default("ACTIVE")
  rewardXp    Int             @default(500)
  rewardGold  Int             @default(250)
  defeatedAt  DateTime?
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  BossMilestone[]
}

model BossMilestone {
  id          String    @id @default(uuid())
  bossId      String
  taskId      String?   @unique
  title       String
  damageHp    Int
  status      String    @default("PENDING")
  completedAt DateTime?

  boss        Boss      @relation(fields: [bossId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Item {
  id          String      @id
  name        String
  itemType    String
  description String
  priceGold   Int
  assetKey    String
  isActive    Boolean     @default(true)

  inventory   Inventory[]
}

model Inventory {
  id         String   @id @default(uuid())
  userId     String
  itemId     String
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model XpTransaction {
  id          String   @id @default(uuid())
  userId      String
  deltaXp     Int
  deltaGold   Int
  sourceType  String
  sourceId    String?
  description String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
