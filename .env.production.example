# ==========================================
# LEVVO PRODUCTION ENVIRONMENT VARIABLES (VERCEL)
# ==========================================

# 1. Cloud Database Connection String (PostgreSQL from Neon.tech or Supabase.com)
# Example (Neon): postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication Secret (Random 32+ characters for signing session cookies)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="levvo-arcade-production-secret-replace-with-random-32-chars"

# 3. Production App URL (Your Vercel domain)
NEXT_PUBLIC_APP_URL="https://levvo.vercel.app"

# 4. Optional: Google Gemini API Key (For AI Plan My Day and AI Campaign Quest generation)
GEMINI_API_KEY=""
